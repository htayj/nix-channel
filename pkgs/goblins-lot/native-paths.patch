Goblins' Lot 497febb: prefix-local install, current Boost and Nixpkgs Python.

- Fix the XDG_CONFIG_HOME directory name typo (goblinw-lot).
- Install the fallback pixmap under the prefix instead of /usr/share/pixmaps.
- Boost.System is header-only since Boost 1.69; drop the compiled component.
- zlib is a dynamic stdlib extension in Nixpkgs Python, not a libpython
  builtin, so do not register PyInit_zlib as an inittab module.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -32,7 +32,7 @@
 SET(GOBLIN_CAMP_DATA_BASE_DIR "${CMAKE_INSTALL_PREFIX}/share" CACHE PATH "Base Data Dir Path")
 SET(GOBLIN_CAMP_SHAREDIR "${GOBLIN_CAMP_DATA_BASE_DIR}/games/goblins-lot" CACHE PATH "Path to Goblins' Lot shared files")
 
-find_package(Boost REQUIRED COMPONENTS system filesystem serialization iostreams)
+find_package(Boost REQUIRED COMPONENTS filesystem serialization iostreams)
 find_package(Boost COMPONENTS python REQUIRED)
 
 find_package(Boost COMPONENTS python3 REQUIRED)
@@ -193,7 +193,6 @@
   ${SDL2_LIBRARY}
   ${SDL2_IMAGE_LIBRARY}
   ${Python3_LIBRARIES}
-  ${Boost_SYSTEM_LIBRARY}
   ${Boost_FILESYSTEM_LIBRARY}
   ${Boost_SERIALIZATION_LIBRARY}
   ${Boost_IOSTREAMS_LIBRARY}
