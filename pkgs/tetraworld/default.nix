{ lib, stdenv, fetchFromGitHub, ldc, scons, libx11, libxext, libxrender, libxft, libxtst }:

let
  # Build-only D library; upstream tracks it as an unpopulated gitlink.
  arsd = fetchFromGitHub {
    owner = "adamdruppe";
    repo = "arsd";
    rev = "d5c35392931925ca75fe3a399de6c254b57673b0";
    hash = "sha256-WBH/bZvyRvFHrMsB4Er9+nFz6U7zA1HZE9rO4wEFtmI=";
  };

  boostLicense = ''
    Boost Software License - Version 1.0 - August 17th, 2003

    Permission is hereby granted, free of charge, to any person or organization
    obtaining a copy of the software and accompanying documentation covered by
    this license (the "Software") to use, reproduce, display, distribute,
    execute, and transmit the Software, and to prepare derivative works of the
    Software, and to permit third-parties to whom the Software is furnished to
    do so, all subject to the following:

    The copyright notices in the Software and this entire statement, including
    the above license grant, this restriction and the following disclaimer,
    must be included in all copies of the Software, in whole or in part, and
    all derivative works of the Software, unless such copies or derivative
    works are solely in the form of machine-executable object code generated by
    a source language processor.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE, TITLE AND NON-INFRINGEMENT. IN NO EVENT
    SHALL THE COPYRIGHT HOLDERS OR ANYONE DISTRIBUTING THE SOFTWARE BE LIABLE
    FOR ANY DAMAGES OR OTHER LIABILITY, WHETHER IN CONTRACT, TORT OR OTHERWISE,
    ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.
  '';
  xlib = name: pkg: "${lib.getLib pkg}/lib/lib${name}.so";
in
stdenv.mkDerivation {
  pname = "tetraworld";
  version = "0-unstable-2021-04-06";

  src = fetchFromGitHub {
    owner = "blargdag";
    repo = "tetraworld";
    rev = "14f5ca8265db8be91266922ea1718579d1481d68";
    hash = "sha256-7OjTVZ0MQrrOF1M0cbVCgvUHzud7mVWdUK9WMHUtpTQ=";
  };

  nativeBuildInputs = [ ldc scons ];

  postUnpack = ''
    cp -r ${arsd}/. "$sourceRoot/arsd/"
    chmod -R u+w "$sourceRoot/arsd"
  '';

  postPatch = ''
    # Upstream release binaries and its SCP upload tool are not built.
    rm -r releases upload.d upload.files

    # Modern D requires const hashing for custom-equality AA keys.
    substituteInPlace vector.d --replace-fail '    bool opEquals' \
      '    size_t toHash() const nothrow @safe { return hashOf(impl); }

        bool opEquals'
    substituteInPlace components.d --replace-fail '    this(int[4] _coors' \
      '    size_t toHash() const nothrow @safe { return coors.toHash(); }

        this(int[4] _coors'
    # Restored special agents already have queued turns: skip only that
    # registration, then process the remaining pending agents.
    substituteInPlace agent.d --replace-fail '                return;' '                continue;'

    substituteInPlace SConstruct \
      --replace-fail '/usr/src/d/ldc/latest/bin/ldc2' '${ldc}/bin/ldc2' \
      --replace-fail 'env = Environment(' 'env = Environment(ENV=dict(os.environ),' \
      --replace-fail 'ldcflags = [ ]' "ldcflags = ['-gcc=cc', '-d-version=without_opengl', '-d-version=without_libnotify', '-L-ldl']" \
      --replace-fail '"./%s" % testprog' '"./%s --DRT-testmode=test-only" % testprog'

    # arsd dlopens X libraries by soname; resolve them in the store.
    substituteInPlace arsd/simpledisplay.d \
      --replace-fail 'dlopen("lib" ~ library ~ ".so", RTLD_NOW)' \
        'dlopen((library == "X11" ? "${xlib "X11" libx11}" : library == "Xext" ? "${xlib "Xext" libxext}" : library == "Xrender" ? "${xlib "Xrender" libxrender}" : library == "Xft" ? "${xlib "Xft" libxft}" : "lib" ~ library ~ ".so"), RTLD_NOW)' \
      --replace-fail '"libXtst.so"' '"${xlib "Xtst" libxtst}"'
  '';

  # The tetraworld target depends on the upstream unit-test stamp, so the
  # unit tests run as part of the build.
  buildPhase = ''
    runHook preBuild
    scons tetraworld
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    install -Dm755 tetraworld $out/bin/tetraworld
    doc=$out/share/doc/tetraworld
    install -Dm644 -t $doc LICENSE README.md
    install -Dm644 arsd/LICENSE $doc/arsd/LICENSE
    cat > $doc/arsd/BOOST-LICENSE.txt <<'EOF'
    ${boostLicense}
    EOF
    printf '%s\n' \
      'arsd color.d, simpledisplay.d and terminal.d: Boost Software License 1.0.' \
      'Copyright Adam D. Ruppe, 2011-2021 (simpledisplay.d).' \
      'https://www.boost.org/LICENSE_1_0.txt' > $doc/arsd/NOTICE
    runHook postInstall
  '';

  doInstallCheck = true;
  installCheckPhase = ''
    runHook preInstallCheck
    grep -q '${lib.getLib libx11}/lib/libX11.so' $out/bin/tetraworld
    out_help=$(HOME=$TMPDIR $out/bin/tetraworld --help || true)
    echo "$out_help" | grep -q 'Tetraworld V3.0'
    runHook postInstallCheck
  '';

  meta = {
    description = "Roguelike treasure-hunting game in four-dimensional space";
    homepage = "https://github.com/blargdag/tetraworld";
    license = with lib.licenses; [ gpl2Plus boost ];
    mainProgram = "tetraworld";
    platforms = [ "x86_64-linux" ];
  };
}
